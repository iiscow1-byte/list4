# Copy to `.env` and fill in. `.env` is git-ignored; this file is not, so it
# carries the names and never the values.
#
# Everything here is read server-side only. Nothing in this file is bundled
# into the browser — Nitro reads `process.env` inside `server/`, which never
# ships to a client.

# ---------------------------------------------------------------- Required-ish
# Where the SQLite database lives. Defaults to `data/list.db`.
LIST_DB_PATH=

# YouTube Data API v3. Used for exactly one thing: reading the upload date of a
# verification video, so submitters and reviewers don't have to type it.
# Without it, /api/youtube/upload-date answers `configured: false` and every
# date is left blank — the feature degrades, nothing breaks.
#
# Restrict the key in the Google Cloud console:
#   - API restriction: YouTube Data API v3 only
#   - Application restriction: this server's IP address
# The key is only ever sent as an `X-goog-api-key` header, never in a URL, so it
# cannot leak through a request log, a referrer or a proxy.
YOUTUBE_API_KEY=

# ------------------------------------------------------------------- Site mode
# `1` opens the site to everyone; otherwise it is staff-only (alpha lockdown).
PUBLIC_SITE=
# `1` re-opens registration.
ALLOW_SIGNUPS=
# `1` lets moderators through the lockdown as well as admins.
LOCKDOWN_ALLOW_MODERATORS=
# The account promoted to owner on first boot of an empty database.
BOOTSTRAP_ADMIN_USERNAME=
# Absolute origin, e.g. https://alllevelslist.net. Used to build the links in
# Discord webhook embeds and in verification emails. Without it, no email link
# can be built and verification stays off.
SITE_URL=

# ----------------------------------------------------------------------- Email
# Confirming an address is what makes an account cost an inbox rather than a
# POST, and it gates commenting, posting and submitting.
#
# **Verification is only enforced when a provider and a from-address are both
# set.** Leave these blank and the site works exactly as before: no address is
# asked for, nothing is gated, and any link that would have been sent is logged
# to the console instead. That is deliberate — a deployment that has not set up
# mail must not become one nobody can sign up to.
#
# Set exactly one provider.
RESEND_API_KEY=
POSTMARK_TOKEN=
# The From: address. Must be a domain the provider has verified.
MAIL_FROM=

# --------------------------------------------------------------------- Captcha
# Raises the cost of bulk automated signups. Shown on the sign-up form always,
# and on the sign-in form only after repeated failures from one address.
#
# Off unless both the secret and the site key are set — same reasoning as email.
# Turnstile is free at any volume and usually invisible; hCaptcha works the same
# way if you prefer it. Set one pair, not both.
#
# reCAPTCHA is deliberately unsupported: v3 returns a score rather than a
# verdict, which means silently turning away some proportion of real people.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET=

# ------------------------------------------------------------------ Geometry Dash
# Optional proxy for the GD servers, for hosts that can't reach them directly.
GD_PROXY_URL=
GD_PROXY_TOKEN=

# ------------------------------------------------------------------- Importers
# Each `LIST_SKIP_*=1` turns one importer off. Useful when a source is down, or
# when running locally against a copy of production data.
LIST_SKIP_AUTO_IMPORT=
LIST_SKIP_SHEET_REFRESH=
LIST_SKIP_AREDL_IMPORT=
LIST_SKIP_POINTERCRATE_IMPORT=
LIST_SKIP_GSV_IMPORT=
LIST_SKIP_CCL_IMPORT=
LIST_SKIP_TCL_IMPORT=
LIST_SKIP_TSL_IMPORT=
LIST_SKIP_SFL_IMPORT=
LIST_SKIP_EDI_IMPORT=
LIST_SKIP_LL_IMPORT=
LIST_SKIP_DAILY_DISCORD=
# How long between sheet refreshes, in hours.
LIST_SHEET_REFRESH_HOURS=

# The sheet import deletes levels the sheet no longer carries, so a tab that
# fails to load reads as "these levels are gone" and takes them with it. Three
# guards refuse the run instead: a tab with no header row, a tab that comes back
# under half its current size, and any run that would delete more than 2% of the
# list. `1` waives all three for one run — set it only when a curator really did
# remove that many levels on purpose, and unset it afterwards.
LIST_IMPORT_ALLOW_SHRINK=
