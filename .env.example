# Copy to `.env` and fill in. `.env` is git-ignored; this file is not, so it
# carries the names and never the values.
#
# Everything here is read server-side only. Nothing in this file is bundled
# into the browser — Nitro reads `process.env` inside `server/`, which never
# ships to a client.

# ---------------------------------------------------------------- Required-ish
# Where the SQLite database lives. Defaults to `data/list.db`.
LIST_DB_PATH=

# YouTube Data API v3. Used for exactly one thing: reading the upload date of a
# verification video, so submitters and reviewers don't have to type it.
# Without it, /api/youtube/upload-date answers `configured: false` and every
# date is left blank — the feature degrades, nothing breaks.
#
# Restrict the key in the Google Cloud console:
#   - API restriction: YouTube Data API v3 only
#   - Application restriction: this server's IP address
# The key is only ever sent as an `X-goog-api-key` header, never in a URL, so it
# cannot leak through a request log, a referrer or a proxy.
YOUTUBE_API_KEY=

# ------------------------------------------------------------------- Site mode
# `1` opens the site to everyone; otherwise it is staff-only (alpha lockdown).
PUBLIC_SITE=
# `1` re-opens registration.
ALLOW_SIGNUPS=
# `1` lets moderators through the lockdown as well as admins.
LOCKDOWN_ALLOW_MODERATORS=
# The account promoted to owner on first boot of an empty database.
BOOTSTRAP_ADMIN_USERNAME=
# Absolute origin, e.g. https://alllevelslist.net. Used to build the links in
# Discord webhook embeds; without it they are posted without a link.
SITE_URL=

# ------------------------------------------------------------------ Geometry Dash
# Optional proxy for the GD servers, for hosts that can't reach them directly.
GD_PROXY_URL=
GD_PROXY_TOKEN=

# ------------------------------------------------------------------- Importers
# Each `LIST_SKIP_*=1` turns one importer off. Useful when a source is down, or
# when running locally against a copy of production data.
LIST_SKIP_AUTO_IMPORT=
LIST_SKIP_SHEET_REFRESH=
LIST_SKIP_AREDL_IMPORT=
LIST_SKIP_POINTERCRATE_IMPORT=
LIST_SKIP_GSV_IMPORT=
LIST_SKIP_CCL_IMPORT=
LIST_SKIP_TCL_IMPORT=
LIST_SKIP_TSL_IMPORT=
LIST_SKIP_SFL_IMPORT=
LIST_SKIP_EDI_IMPORT=
LIST_SKIP_LL_IMPORT=
LIST_SKIP_DAILY_DISCORD=
# How long between sheet refreshes, in hours.
LIST_SHEET_REFRESH_HOURS=
